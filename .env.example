DATA_MODE=synthetic
REGULATED_DATA_RESIDENCY=ET
ALLOW_EXTERNAL_TELEMETRY=false
HOST=127.0.0.1
PORT=3000
# Optional local synthetic-development persistence only. Never store real customer data here.
# SYNTHETIC_STATE_DIR=.synthetic-state
# Fail closed when a deployment is expected to use restart-durable synthetic sessions.
# REQUIRE_DURABLE_SESSION_STORE=false

# Phase 1A D1 PostgreSQL foundation — local synthetic engineering only.
# Disabled by default; non-loopback database hosts fail closed in this bounded slice.
# D1_POSTGRES_ENABLED=false
# D1_POSTGRES_MODE=local-synthetic
# D1_POSTGRES_URL=postgresql://postgres:<local-password>@127.0.0.1:5432/enawuga_d1
# Optional local operations UI role testing. Default remains false/AGENT-only.
# This is synthetic development auth, not PartnerFI SSO or production access control.
# ALLOW_PRIVILEGED_SYNTHETIC_ROLES=false

# Stage 2 — current ArifPay developer-portal sandbox only.
# Network remains disabled until intentionally exercised from an approved dev environment.
# Never place production keys or real customer data in this configuration.
# ARIFPAY_MODE=sandbox
# ARIFPAY_SANDBOX_NETWORK_ENABLED=false
# ARIFPAY_SANDBOX_BASE_URL=https://gateway.arifpay.org
# ARIFPAY_SANDBOX_API_KEY=arif-sandbox-portal-key
# Checkout path is pinned in code from the current official Sandbox Postman collection:
# /api/sandbox/c2b/session
# Reconciliation reads only the verified sandbox session path:
# /api/sandbox/checkout/session/{sessionId}
# ARIFPAY_SANDBOX_NOTIFY_URL=http://localhost:3000/api/sandbox/webhook-inbox
# ARIFPAY_SANDBOX_SUCCESS_URL=https://payment.arifpay.org/success
# ARIFPAY_SANDBOX_CANCEL_URL=https://payment.arifpay.org/Cancel
# ARIFPAY_SANDBOX_ERROR_URL=https://payment.arifpay.org/Error
# ARIFPAY_SANDBOX_TIMEOUT_MS=15000

# Direct Telebirr developer/test workstream — sandbox only.
# All credentials/private keys stay server-side and outside Git. Values below are placeholders.
# Provider networking remains disabled unless explicitly enabled.
# TELEBIRR_MODE=sandbox
# TELEBIRR_SANDBOX_NETWORK_ENABLED=false
# TELEBIRR_SANDBOX_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# TELEBIRR_FABRIC_APP_ID=<sandbox-fabric-app-id>
# TELEBIRR_APP_SECRET=<sandbox-app-secret>
# TELEBIRR_MERCHANT_APP_ID=<sandbox-merchant-app-id>
# TELEBIRR_MERCHANT_CODE=<sandbox-short-code>
# TELEBIRR_PRIVATE_KEY=<sandbox-private-key-from-secret-store>
# TELEBIRR_NOTIFY_URL=https://example.invalid/telebirr/notify
# TELEBIRR_SANDBOX_TIMEOUT_MS=15000
