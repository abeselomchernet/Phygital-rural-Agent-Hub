DATA_MODE=synthetic
REGULATED_DATA_RESIDENCY=ET
ALLOW_EXTERNAL_TELEMETRY=false
HOST=127.0.0.1
PORT=3000
# Optional local synthetic-development persistence only. Never store real customer data here.
# SYNTHETIC_STATE_DIR=.synthetic-state

# Stage 2 — ArifPay sandbox only. Leave unset/disabled until the current
# official Sandbox/Postman contract is verified. Never place production keys here.
# ARIFPAY_MODE=sandbox
# ARIFPAY_SANDBOX_NETWORK_ENABLED=false
# ARIFPAY_SANDBOX_BASE_URL=https://gateway.arifpay.org
# ARIFPAY_SANDBOX_API_KEY=<official-portal-sandbox-test-key>
# ARIFPAY_SANDBOX_CHECKOUT_PATH=<current-relative-path-from-official-sandbox-contract>
# ARIFPAY_SANDBOX_BENEFICIARY_ACCOUNT=<synthetic-sandbox-beneficiary>
# ARIFPAY_SANDBOX_BENEFICIARY_BANK=<synthetic-sandbox-bank-code>
# ARIFPAY_SANDBOX_NOTIFY_URL=https://sandbox.example.invalid/arifpay/notify
# ARIFPAY_SANDBOX_SUCCESS_URL=https://sandbox.example.invalid/arifpay/success
# ARIFPAY_SANDBOX_CANCEL_URL=https://sandbox.example.invalid/arifpay/cancel
# ARIFPAY_SANDBOX_ERROR_URL=https://sandbox.example.invalid/arifpay/error
# ARIFPAY_SANDBOX_TIMEOUT_MS=15000
